<Window x:Class="SteamAchievementUnlocker.GameManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Steam Achievement Unlocker - Game" Width="960" Height="640"
        MinWidth="840" MinHeight="480" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#0F141C" Foreground="#E8EEF6"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="Background" Value="#263552" />
            <Setter Property="BorderBrush" Value="#344665" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A4E78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F70B1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7DA7F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D2DCE8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C374A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Foreground" Value="#AEB9CD" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#2B3A56" />
                                <Setter Property="Foreground" Value="#F1F4FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#4F70B1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#C8D1E1" />
            <Setter Property="Background" Value="#263553" />
            <Setter Property="BorderBrush" Value="#344665" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBody" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBody" Property="Background" Value="#35486D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBody" Property="Background" Value="#4F70B1" />
                                <Setter TargetName="ToggleBody" Property="BorderBrush" Value="#6E93DB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBody" Property="BorderBrush" Value="#7DA7F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E2E7F2" />
            <Setter Property="Background" Value="#131D2C" />
            <Setter Property="BorderBrush" Value="#34445D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#8FB4FA" />
            <Setter Property="SelectionBrush" Value="#4F70B1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                           Margin="12,0" VerticalAlignment="Center" Foreground="#68768C"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#506582" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6E93DB" />
                                <Setter TargetName="InputBorder" Property="Background" Value="#172337" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#172131" />
            <Setter Property="Foreground" Value="#6E93DB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Width="110" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressTransform" X="-110" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ProgressTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-110" To="390" Duration="0:0:1.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="#26344A" />
            <Setter Property="Foreground" Value="#7DA7F5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Border Width="14" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IconProgressTransform" X="-14" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IconProgressTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-14" To="44" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7DFEC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBody" Width="17" Height="17" CornerRadius="4"
                                    Background="#131D2C" BorderBrush="#4A5A72" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Width="10" Height="7" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M1,3 L4,6 L9,1"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBody" Property="Background" Value="#4F70B1" />
                                <Setter TargetName="CheckBody" Property="BorderBrush" Value="#6E93DB" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBody" Property="BorderBrush" Value="#7DA7F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#BFC9D9" />
            <Setter Property="Background" Value="#172231" />
            <Setter Property="BorderBrush" Value="#2A384B" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBody" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBody" Property="Background" Value="#202D3F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#BFC9D9" />
            <Setter Property="Background" Value="#172231" />
            <Setter Property="BorderBrush" Value="#2A384B" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0F141C" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="RowBackground" Value="#131B25" />
            <Setter Property="AlternatingRowBackground" Value="#17202B" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#283242" />
            <Setter Property="BorderBrush" Value="#2A3544" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="Background" Value="#131B25" />
            <Setter Property="BorderBrush" Value="#283242" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#17202B" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D2938" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263A59" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111A2F" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource WindowButton}" Click="OnBack"
                    ToolTip="Back to games">
                <Path Width="14" Height="14" Stroke="#D2DCE8" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M9,2 L3,7 L9,12 M3,7 H13" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="27" Height="27" CornerRadius="7" Background="#4F70B1" Margin="0,0,10,0">
                    <Path Width="15" Height="15" Fill="White" Stretch="Uniform"
                          Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z" />
                </Border>
                <TextBlock x:Name="TitleText" Text="Steam Achievement Unlocker - Game"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="#F3F6FC" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource WindowButton}" Click="OnMinimize">
                    <Path Width="10" Height="1" Fill="#D2DCE8" Data="M0,0 H10 V1 H0 Z" />
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="OnMaximize">
                    <Path Width="10" Height="10" Stroke="#D2DCE8" StrokeThickness="1"
                          Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                </Button>
                <Button Click="OnClose">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E85D68" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.2"
                          Data="M1,1 L9,9 M9,1 L1,9" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#18233B" BorderBrush="#26344B" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,12">
                <Button x:Name="_reloadButton" Style="{StaticResource ActionButton}" Margin="4,0,4,0"
                        ToolTip="Refresh achievement and statistic data (F5)" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Margin="0,0,8,0" Fill="#F5F7FC" Stretch="Uniform"
                              Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="_resetButton" Style="{StaticResource ActionButton}"
                        ToolTip="Reset statistics or achievements" Click="OnResetAllStats">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Margin="0,0,8,0" Stroke="#F5F7FC"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Data="M6,7 H2 V3 M2,7 C3.5,3.5 7,2 10.5,2.5 C14.8,3.1 18,6.8 18,11.2 C18,16 14.1,20 9.2,20 C5.8,20 2.8,18.1 1.3,15.3" />
                        <TextBlock Text="Reset" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Grid.Column="1" Height="48" Padding="3" Margin="0,0,0,1"
                    VerticalAlignment="Center" SnapsToDevicePixels="False"
                    Background="#121B2A" BorderBrush="#33445E" BorderThickness="1" CornerRadius="11">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="_achievementsSegment" Style="{StaticResource SegmentButton}"
                                 GroupName="DetailTabs" Content="Achievements" IsChecked="True"
                                 Click="OnSelectAchievementsTab" />
                    <RadioButton x:Name="_statisticsSegment" Style="{StaticResource SegmentButton}"
                                 GroupName="DetailTabs" Content="Statistics"
                                 Click="OnSelectStatisticsTab" />
                </StackPanel>
            </Border>
            <Button x:Name="_storeButton" Grid.Column="2" Style="{StaticResource ActionButton}"
                    Background="#4F70B1" BorderBrush="#6285C8" HorizontalAlignment="Right"
                    Margin="16,12" ToolTip="Save achievement and statistic changes (Ctrl+S)" Click="OnStore">
                <StackPanel Orientation="Horizontal">
                    <Path Width="15" Height="15" Margin="0,0,8,0" Fill="#F5F7FC" Stretch="Uniform"
                          Data="M4,3 H16 L21,8 V21 H3 V3 Z M6,5 V10 H16 V5 Z M6,13 H18 V19 H6 Z" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        </Border>

        <TabControl x:Name="_mainTabControl" Grid.Row="2" Background="#0F141C" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem>
                <Grid Background="#0F141C">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#151F30" BorderBrush="#26344B" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="16,12,16,14" HorizontalAlignment="Left">
                            <TextBlock Text="SHOW" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#8FA2BF" />
                            <ToggleButton x:Name="_displayLockedOnlyButton" Style="{StaticResource FilterToggle}"
                                          Content="Locked" Checked="OnDisplayUncheckedOnly" Unchecked="OnDisplayUncheckedOnly" />
                            <ToggleButton x:Name="_displayUnlockedOnlyButton" Style="{StaticResource FilterToggle}"
                                          Content="Unlocked" Checked="OnDisplayCheckedOnly" Unchecked="OnDisplayCheckedOnly" />
                            <TextBlock Text="FILTER" Margin="16,0,8,0" VerticalAlignment="Center"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#8FA2BF" />
                            <TextBox x:Name="_matchingStringTextBox" Width="180"
                                     Style="{StaticResource InputBox}" Tag="Search achievements..."
                                     ToolTip="Filter by achievement name or description (Ctrl+F)"
                                     TextChanged="OnFilterUpdate" KeyDown="OnAchievementFilterKeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,12,16,14" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButton}" ToolTip="Lock all visible achievements"
                                    Click="OnLockAll">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,7,0" Fill="#F5F7FC" Stretch="Uniform"
                                          Data="M7,10 H17 V21 H7 Z M9,10 V7 C9,3 15,3 15,7 V10 H13 V7 C13,5 11,5 11,7 V10 Z" />
                                    <TextBlock Text="Lock all" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" ToolTip="Invert all visible achievements"
                                    Click="OnInvertAll">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Margin="0,0,7,0" Stroke="#F5F7FC"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Data="M3,7 H17 M14,4 L17,7 L14,10 M21,17 H7 M10,14 L7,17 L10,20" />
                                    <TextBlock Text="Invert" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" ToolTip="Unlock all visible achievements"
                                    Click="OnUnlockAll">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Margin="0,0,7,0" Fill="#F5F7FC" Stretch="Uniform"
                                          Data="M7,10 H17 V21 H7 Z M9,10 V7 C9,3 15,3 15,7 H13 C13,5 11,5 11,7 V10 Z" />
                                    <TextBlock Text="Unlock all" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="14,12">
                    <ListView x:Name="_achievementListView" ItemsSource="{Binding Achievements}"
                              Background="#0F141C" Foreground="#E8EEF6"
                              BorderBrush="#2A3544" BorderThickness="1"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources>
                            <Style x:Key="AchievementScrollPageButton" TargetType="RepeatButton">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="#131B25" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="AchievementScrollThumb" TargetType="Thumb">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Width" Value="6" />
                                <Setter Property="Background" Value="#465775" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBody" Width="{TemplateBinding Width}"
                                                    Background="{TemplateBinding Background}" CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#5D78A8" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#6E93DB" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="0.35" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Margin" Value="2,3,2,3" />
                                <Setter Property="Background" Value="#18212E" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Track x:Name="PART_Track" Margin="3,4"
                                                       Minimum="{TemplateBinding Minimum}"
                                                       Maximum="{TemplateBinding Maximum}"
                                                       Value="{TemplateBinding Value}"
                                                       ViewportSize="{TemplateBinding ViewportSize}"
                                                       Orientation="{TemplateBinding Orientation}"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource AchievementScrollPageButton}"
                                                                      Command="ScrollBar.PageUpCommand" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource AchievementScrollThumb}" />
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource AchievementScrollPageButton}"
                                                                      Command="ScrollBar.PageDownCommand" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Orientation" Value="Horizontal">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger SourceName="PART_Track" Property="IsEnabled" Value="False">
                                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="#E8EEF6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBody" Background="{TemplateBinding Background}"
                                                    BorderBrush="#202B3A" BorderThickness="0,0,0,1"
                                                    SnapsToDevicePixels="True">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter TargetName="RowBody" Property="Background" Value="#251A20" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBody" Property="Background" Value="#1E2A3B" />
                                                    <Setter Property="Foreground" Value="#F5F7FB" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBody" Property="Background" Value="#263A59" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="104">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsAchieved, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="4"
                                                          PreviewMouseLeftButtonDown="OnCheckAchievement" />
                                                <Grid Width="48" Height="48" Margin="6,6,10,6">
                                                    <Border Background="#182231" BorderBrush="#2D3C50"
                                                            BorderThickness="1" CornerRadius="6">
                                                        <Grid>
                                                            <Path x:Name="IconPlaceholder" Width="20" Height="20"
                                                                  Fill="#56667E" Stretch="Uniform"
                                                                  Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z" />
                                                            <ProgressBar x:Name="IconLoader" Width="30"
                                                                         Margin="0,0,0,7" VerticalAlignment="Bottom"
                                                                         Style="{StaticResource IconProgressBar}"
                                                                         IsIndeterminate="True" Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <Image x:Name="AchievementIcon" Source="{Binding Icon}"
                                                           Stretch="Uniform" />
                                                </Grid>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter TargetName="AchievementIcon" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIconLoading}" Value="True">
                                                    <Setter TargetName="IconPlaceholder" Property="Opacity" Value="0.3" />
                                                    <Setter TargetName="IconLoader" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="190" DisplayMemberBinding="{Binding Name}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Name" Tag="Name" Cursor="Hand"
                                                              Click="OnAchievementColumnHeaderClick" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="310" DisplayMemberBinding="{Binding Description}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Description" Tag="Description" Cursor="Hand"
                                                              Click="OnAchievementColumnHeaderClick" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="115" DisplayMemberBinding="{Binding GlobalUnlockPercentageText}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Global unlock" Tag="GlobalUnlockPercentage"
                                                              Cursor="Hand" Click="OnAchievementColumnHeaderClick" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="135" DisplayMemberBinding="{Binding UnlockTimeText}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Unlocked" Tag="UnlockTime" Cursor="Hand"
                                                              Click="OnAchievementColumnHeaderClick" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border x:Name="_achievementEmptyState" Background="#0F141C"
                            BorderBrush="#2A3544" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#1B2940"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Width="23" Height="23" Stroke="#7DA7F5" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z" />
                            </Border>
                            <TextBlock Text="No achievements found" HorizontalAlignment="Center"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#E8EEF6" />
                            <TextBlock Text="Try changing the display options or search filter."
                                       Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#8290A5" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <Grid Background="#0F141C" Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="52" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="_statisticsDataGridView" ItemsSource="{Binding Statistics}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              AlternationCount="2">
                        <DataGrid.Resources>
                            <Style x:Key="StatisticsScrollPageButton" TargetType="RepeatButton">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="StatisticsScrollThumb" TargetType="Thumb">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Width" Value="6" />
                                <Setter Property="Background" Value="#465775" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBody" Width="{TemplateBinding Width}"
                                                    Background="{TemplateBinding Background}" CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#5D78A8" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#6E93DB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Margin" Value="2,3,2,3" />
                                <Setter Property="Background" Value="#18212E" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Track x:Name="PART_Track" Margin="3,4"
                                                       Minimum="{TemplateBinding Minimum}"
                                                       Maximum="{TemplateBinding Maximum}"
                                                       Value="{TemplateBinding Value}"
                                                       ViewportSize="{TemplateBinding ViewportSize}"
                                                       Orientation="{TemplateBinding Orientation}"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource StatisticsScrollPageButton}"
                                                                      Command="ScrollBar.PageUpCommand" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource StatisticsScrollThumb}" />
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource StatisticsScrollPageButton}"
                                                                      Command="ScrollBar.PageDownCommand" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Orientation" Value="Horizontal">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger SourceName="PART_Track" Property="IsEnabled" Value="False">
                                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn x:Name="_statisticsValueColumn" Header="Value" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Value" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Extra" Binding="{Binding Extra}" Width="2*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,0" Background="#151F30"
                            BorderBrush="#2A3544" BorderThickness="1" CornerRadius="7">
                        <CheckBox x:Name="_enableStatsEditingCheckBox" VerticalAlignment="Center"
                                  Content="I understand that editing statistics can break game progress"
                                  Checked="OnStatAgreementChecked" Unchecked="OnStatAgreementChecked" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" x:Name="_loadingOverlay" Panel.ZIndex="20" Background="#F20F141C"
              Visibility="Collapsed">
            <Border Width="360" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#172231" BorderBrush="#34445D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#263A59"
                            HorizontalAlignment="Center">
                        <Path Width="23" Height="23" Fill="#EAF1FF" Stretch="Uniform"
                              Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z" />
                    </Border>
                    <TextBlock Text="Loading game data" Margin="0,14,0,5" HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold" Foreground="#F3F6FC" />
                    <TextBlock Text="Retrieving achievements and statistics from Steam..."
                               HorizontalAlignment="Center" Foreground="#8290A5" />
                    <ProgressBar Style="{StaticResource ModernProgressBar}" IsIndeterminate="True"
                                 Width="270" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Background="#111A2F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#6E93DB" Margin="0,0,9,0" />
                <TextBlock x:Name="_gameStatusLabel" VerticalAlignment="Center" Foreground="#A6B0C7" />
            </StackPanel>
            <TextBlock x:Name="_downloadStatusLabel" Grid.Column="1" Margin="16,0,8,0"
                       VerticalAlignment="Center" Foreground="#8EB2EF" Visibility="Collapsed" />
            <TextBlock Grid.Column="2" Text="www.engazan.eu" Margin="12,0,16,0"
                       VerticalAlignment="Center" FontSize="11" Foreground="#71829A" />
        </Grid>
    </Grid>
</Window>
