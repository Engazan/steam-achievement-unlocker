<Window x:Class="SteamAchievementUnlocker.GameSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Steam Achievement Unlocker | Pick a game... Any game..."
        Width="960" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Background="#0F141C" Foreground="#E8EEF6"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E7EBF5" />
            <Setter Property="Background" Value="#263552" />
            <Setter Property="BorderBrush" Value="#344665" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A4E78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F70B1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7DA7F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E2E7F2" />
            <Setter Property="Background" Value="#131D2C" />
            <Setter Property="BorderBrush" Value="#34445D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#8FB4FA" />
            <Setter Property="SelectionBrush" Value="#4F70B1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                           Margin="12,0" VerticalAlignment="Center"
                                           Foreground="#68768C" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#506582" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6E93DB" />
                                <Setter TargetName="InputBorder" Property="Background" Value="#172337" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#172131" />
            <Setter Property="Foreground" Value="#6E93DB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Width="110" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ProgressTransform" X="-110" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ProgressTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-110" To="390" Duration="0:0:1.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#17202C" />
            <Setter Property="Foreground" Value="#E7EDF7" />
            <Setter Property="BorderBrush" Value="#34445A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#DDE5F1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBody" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="CheckMark" Width="11" Height="8" Stroke="#8FB4FA"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M1,4 L4,7 L10,1"
                                      Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBody" Property="Background" Value="#263652" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D2DCE8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="46" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C374A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111A2F" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="27" Height="27" Margin="18,0,10,0" CornerRadius="7"
                    Background="#4F70B1" VerticalAlignment="Center">
                <Path Width="15" Height="15" Fill="White" Stretch="Uniform"
                      Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z M6,7 H5 V8 C5,9.48 6.08,10.71 7.5,10.95 C6.54,9.75 6,8.23 6,6.58 Z M18,7 V6.58 C18,8.23 17.46,9.75 16.5,10.95 C17.92,10.71 19,9.48 19,8 V7 Z" />
            </Border>
            <TextBlock Grid.Column="1" Text="Steam Achievement Unlocker" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" Foreground="#F3F6FC" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource WindowButton}" Click="OnMinimize">
                    <Path Width="10" Height="1" Fill="#D2DCE8" Data="M0,0 H10 V1 H0 Z" />
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="OnMaximize">
                    <Path Width="10" Height="10" Stroke="#D2DCE8" StrokeThickness="1"
                          Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                </Button>
                <Button Click="OnClose">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E85D68" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.2"
                          Data="M1,1 L9,9 M9,1 L1,9" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#18233B" BorderBrush="#26344B" BorderThickness="0,0,0,1">
            <Grid Margin="20,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SEARCH LIBRARY" Margin="2,0,0,4" FontSize="10"
                               FontWeight="SemiBold" Foreground="#8290A7" />
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource InputBox}" Tag="Search games..."
                             TextChanged="OnFilterUpdate" KeyDown="OnSearchKeyDown" />
                </StackPanel>

                <Button x:Name="FiltersButton" Grid.Column="2" Style="{StaticResource ToolbarButton}"
                        VerticalAlignment="Top" Margin="0,16,0,0"
                        ToolTip="Choose which library items are shown"
                        Click="OnOpenFilters">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="14" Margin="0,0,8,0" Fill="#F5F7FC" Stretch="Uniform"
                              Data="M4,5 H20 V7 H4 Z M7,11 H17 V13 H7 Z M10,17 H14 V19 H10 Z" />
                        <TextBlock Text="Filters" VerticalAlignment="Center" />
                        <Path Width="8" Height="5" Margin="8,1,0,0" Fill="#C9D4E8" Stretch="Uniform"
                              VerticalAlignment="Center" Data="M0,0 H8 L4,5 Z" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Show games" IsCheckable="True" IsChecked="True"
                                      x:Name="ShowGamesMenuItem" Checked="OnFilterUpdate" Unchecked="OnFilterUpdate" />
                            <MenuItem Header="Show demos" IsCheckable="True"
                                      x:Name="ShowDemosMenuItem" Checked="OnFilterUpdate" Unchecked="OnFilterUpdate" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RefreshButton" Grid.Column="4" Style="{StaticResource ToolbarButton}"
                        Background="#4F70B1" BorderBrush="#6285C8"
                        VerticalAlignment="Top" Margin="0,16,0,0"
                        ToolTip="Refresh games and achievement progress" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Margin="0,0,8,0" Fill="#F5F7FC" Stretch="Uniform"
                              Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ListBox x:Name="GameList" Grid.Row="2" Background="#0F141C" BorderThickness="0"
                 Foreground="White" ItemsSource="{Binding}" MouseDoubleClick="OnActivateGame"
                 KeyDown="OnGameListKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.ScrollChanged="OnGameListScrollChanged">
            <ListBox.Resources>
                <Style x:Key="GameListScrollPageButton" TargetType="RepeatButton">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="{TemplateBinding Background}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="GameListScrollThumb" TargetType="Thumb">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Width" Value="6" />
                    <Setter Property="Background" Value="#465775" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbBody" Width="{TemplateBinding Width}"
                                        Background="{TemplateBinding Background}" CornerRadius="3" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#5D78A8" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#6E93DB" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Margin" Value="2,3,2,3" />
                    <Setter Property="Background" Value="#18212E" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <Track x:Name="PART_Track" Margin="3,4"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}"
                                           ViewportSize="{TemplateBinding ViewportSize}"
                                           Orientation="{TemplateBinding Orientation}"
                                           IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource GameListScrollPageButton}"
                                                          Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource GameListScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource GameListScrollPageButton}"
                                                          Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger SourceName="PART_Track" Property="IsEnabled" Value="False">
                                        <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Margin="13" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="7" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="ToolTip" Value="{Binding Name}" />
                    <Setter Property="ToolTipService.ShowDuration" Value="5000" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="#171F2A" BorderBrush="#2A3544"
                                        BorderThickness="1" CornerRadius="9" ClipToBounds="True"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#5D7DB8" />
                                        <Setter TargetName="Card" Property="Background" Value="#1D2837" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#7DA7F5" />
                                        <Setter TargetName="Card" Property="Background" Value="#1F2D42" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#9ABAF4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="204" Height="112" Loaded="OnGameCardLoaded">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,204,112" RadiusX="8" RadiusY="8" />
                        </Grid.Clip>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                            <Border Background="#2A3340" CornerRadius="8,8,0,0" ClipToBounds="True">
                                <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                            </Border>
                            <Border Background="#202B3A" CornerRadius="8,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="110" Style="{StaticResource ModernProgressBar}"
                                                 IsIndeterminate="True" />
                                    <TextBlock Text="Loading image..." Margin="0,7,0,0"
                                               Foreground="#9EACC0" FontSize="10"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,7,7,0" Padding="8,4" CornerRadius="6"
                                    Background="#EE111A28" BorderBrush="#60738F" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAchievementProgress}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Margin="0,0,5,0"
                                          Fill="#F4C95D" Stretch="Uniform"
                                          Data="M6,2 H18 V5 H21 V8 C21,10.76 18.76,13 16,13 H15.82 C15.4,15.02 13.93,16.65 12,17.32 V20 H16 V22 H8 V20 H12 V17.32 C10.07,16.65 8.6,15.02 8.18,13 H8 C5.24,13 3,10.76 3,8 V5 H6 Z M6,7 H5 V8 C5,9.48 6.08,10.71 7.5,10.95 C6.54,9.75 6,8.23 6,6.58 Z M18,7 V6.58 C18,8.23 17.46,9.75 16.5,10.95 C17.92,10.71 19,9.48 19,8 V7 Z" />
                                    <TextBlock Text="{Binding AchievementProgress}" Foreground="#F6F8FC"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#18212D" BorderBrush="#253142"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding Name}" Padding="10,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" FontSize="12.5" FontWeight="Medium"
                                       Foreground="#F1F4F9" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Width="52" Height="52" CornerRadius="26" Background="#1C2736"
                    HorizontalAlignment="Center">
                <Path Width="22" Height="22" Stroke="#7588A5" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                      Data="M3,10 A7,7 0 1 1 17,10 A7,7 0 1 1 3,10 M15.5,15.5 L21,21" />
            </Border>
            <TextBlock Text="No games found" Margin="0,14,0,4" HorizontalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="#E4EAF4" />
            <TextBlock Text="Try another search or adjust your filters."
                       Foreground="#8391A6" />
        </StackPanel>

        <Border Grid.Row="3" Background="#111A2F" BorderBrush="#243148" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="18,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#6E93DB" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Foreground="#AAB5C7" />
                </StackPanel>
                <TextBlock x:Name="DownloadStatusText" Grid.Column="1" Margin="16,0,8,0"
                           VerticalAlignment="Center" Foreground="#8EB2EF" Visibility="Collapsed" />
                <TextBlock Grid.Column="2" Text="www.engazan.eu" Margin="12,0,18,0"
                           VerticalAlignment="Center" FontSize="11" Foreground="#71829A" />
            </Grid>
        </Border>

        <Border x:Name="LoadingOverlay" Grid.Row="2" Panel.ZIndex="10" Background="#ED0F141C">
            <Border Width="390" Height="178" Background="#192331" BorderBrush="#34445A"
                    BorderThickness="1" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#4F70B1" Margin="0,0,12,0">
                            <Path Width="17" Height="17" Fill="White" Stretch="Uniform"
